Content-Type: application/json

{
    "first_name": "Vimal",
    "last_name": "Krishna",
    "username": "vimal",
    "email": "vimal@gmail.com",
    "password": "vimal123"
}

###
GET http://127.0.0.1:8000/users/
Authorization: Basic vimal:vimal123

###
