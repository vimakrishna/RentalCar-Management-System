### Search by car name
GET http://127.0.0.1:8000/cars/?search=Swift
Accept: application/json


### Search by brand
GET http://127.0.0.1:8000/cars/?search=KIA
Accept: application/json


### Filter by fuel type
GET http://127.0.0.1:8000/cars/?fuel_type=Petrol
Accept: application/json


### Filter by maximum rent
GET http://127.0.0.1:8000/cars/?max_rent=2000
Accept: application/json


### Search and multiple filters
GET http://127.0.0.1:8000/cars/?search=KIA&fuel_type=Petrol&max_rent=2000
Accept: application/json


### Invalid rent test
GET http://127.0.0.1:8000/cars/?max_rent=2000
Accept: application/json


###
# Low rent to high rent
GET http://127.0.0.1:8000/cars/?ordering=rent_per_day
Accept: application/json

###
# High rent to low rent
GET http://127.0.0.1:8000/cars/?ordering=-rent_per_day
Accept: application/json

###
# Sort by car name
GET http://127.0.0.1:8000/cars/?ordering=car_name
Accept: application/json

###
# Sort by seating capacity
GET http://127.0.0.1:8000/cars/?ordering=seating_capacity
Accept: application/json
